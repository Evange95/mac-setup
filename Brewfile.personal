# =============================================================================
# Brewfile.personal — installed only with --profile personal
# =============================================================================

cask "obsidian"
cask "proton-mail"       # Quit it when not in use: it is a full browser engine, like every Electron app
cask "telegram"
cask "spotify"
cask "trezor-suite"

# Media, hardware and games
cask "handbrake-app"
cask "transmission"
cask "insta360-link-controller"
cask "macusb"            # Bootable macOS installers
# OpenEmu and melonDS are installed by hand: Homebrew disabled both casks (they fail the
# Gatekeeper check), and a disabled cask makes every `brew bundle` run fail

# LaTeX (CV repos build with XeLaTeX + awesome-cv). BasicTeX is ~100 MB against the 7 GB of
# full MacTeX; the packages it lacks are listed in config/tex/packages.txt and installed by
# the packages step. Installs to /Library/TeX (asks for sudo)
cask "basictex"

# VPN (conflicts with corporate network/VPN agents, so personal only)
cask "nordvpn"

# Mac App Store (needs App Store sign-in)
mas "Xcode", id: 497799835
mas "Developer", id: 640199958
# Keynote, Numbers and Pages moved to new App Store ids; the old 409… ones no longer exist
mas "Keynote", id: 361285480
mas "Numbers", id: 361304891
mas "Pages", id: 361309726
mas "Kindle", id: 302584613
mas "MKPlayer", id: 1335612105
