# =============================================================================
# Brewfile.personal — installed only with --profile personal
# =============================================================================

cask "obsidian"
cask "proton-mail"       # Quit it when not in use: it is a full browser engine, like every Electron app
cask "telegram"
cask "spotify"
cask "trezor-suite"

# Lighter native alternatives on trial next to iTerm2 and VS Code
cask "ghostty"
cask "zed"

# Media, hardware and games
cask "handbrake-app"
cask "transmission"
cask "insta360-link-controller"
cask "macusb"            # Bootable macOS installers
cask "openemu"
cask "melonds"

# LaTeX (CV repos build with XeLaTeX + awesome-cv). Full TeX Live without the GUI apps,
# so tlmgr is never needed for a missing package; installs to /Library/TeX (asks for sudo)
cask "mactex-no-gui"

# VPN (conflicts with corporate network/VPN agents, so personal only)
cask "nordvpn"

# Mac App Store (needs App Store sign-in)
mas "Xcode", id: 497799835
mas "Developer", id: 640199958
mas "Keynote", id: 409183694
mas "Numbers", id: 409203825
mas "Pages", id: 409201541
mas "Kindle", id: 302584613
mas "MKPlayer", id: 1335612105
